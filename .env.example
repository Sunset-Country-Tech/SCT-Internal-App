NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sct_internal"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_COOKIE_SECURE="false"
INTERNAL_USERS_JSON='[{"id":"owner","email":"owner@sunsetcountry.tech","name":"Owner","role":"Owner","passwordHash":"$2b$12$replace-with-bcrypt-hash"}]'

# Docker/Postgres defaults
POSTGRES_DB="sct_internal"
POSTGRES_USER="sct"
POSTGRES_PASSWORD="replace-with-a-database-password"

# SMTP connection settings and secrets
EMAIL_PROVIDER="none"
EMAIL_MODE="outbound-only"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURITY="starttls"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_FROM_NAME="Sunset Country Tech"
SMTP_FROM_EMAIL="hello@sunsetcountry.tech"
SMTP_REPLY_TO_EMAIL="hello@sunsetcountry.tech"
SMTP_AUTH_METHOD="login"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# IMAP connection settings and secrets
IMAP_ENABLED="false"
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURITY="ssl-tls"
IMAP_SECURE="true"
IMAP_USERNAME=""
IMAP_PASSWORD=""
IMAP_INBOX_MAILBOX="INBOX"
IMAP_PROCESSED_MAILBOX="Processed"
IMAP_ERROR_MAILBOX="Needs Review"
IMAP_POLLING_MINUTES="5"

# SMS/SMS-Gate secrets referenced by Settings
SMS_API_KEY=""
SMS_WEBHOOK_SECRET=""

# Calendar secrets referenced by Settings
CALENDAR_API_KEY=""

# Cloudflare R2 / S3-compatible storage secrets referenced by Settings
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
